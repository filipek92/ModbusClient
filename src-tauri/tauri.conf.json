{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modbus Client",
  "mainBinaryName": "modbus-client",
  "version": "../package.json",
  "identifier": "io.github.filipek92.modbusclient",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:9000",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist/spa"
  },
  "app": {
    "windows": [
      {
        "title": "Modbus Client",
        "width": 1000,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Modbus TCP / RTU client",
    "publisher": "Filip Richter",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/default-decoders/": "default-decoders/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5M0FEMjk0Q0YyQTI5N0UKUldSK0tTclBsTkk2R1pTY3V6UVF0azJRYjhQRnBhcTNNUWRtVFZOelBFVkYza2EvWklnSmFSdFMK",
      "endpoints": [
        "https://github.com/filipek92/ModbusClient/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
